# AVEC EFFET MAGNUS (générée par Chatgpt) 
# ----------------------------- 
vx = v0 * np.cos(angle) 
vy = 0 
vz = v0 * np.sin(angle) 
 
x, y, z = 0, 0, 0 
 
X_avec, Y_avec = [], [] 
 
t = 0 
while t < t_max: 
 
    v = np.sqrt(vx**2 + vy**2) 
 
    # effet Magnus → déviation latérale 
    ay = s * v * omega / m 
 
    ax = 0 
    az = -g 
 
    vx += ax * dt 
    vy += ay * dt 
    vz += az * dt 
 
    x += vx * dt 
    y += vy * dt 
    z += vz * dt 
 
    if z >= 0: 
        X_avec.append(x) 
        Y_avec.append(y) 
 
    t += dt 
 
