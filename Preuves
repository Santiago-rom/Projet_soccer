vz = v0 * np.sin(angle) 
 
x, y, z = 0, 0, 0 
 
X_sans, Y_sans = [], [] 
 
t = 0 
 
while t < t_max: #itération 
    ax = 0 
    ay = 0 
    az = -g 
 
    vx += ax * dt 
